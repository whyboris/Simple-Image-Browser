{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Image Browser",
  "version": "1.0.0",
  "identifier": "com.simpleimagebrowser.simpleimagebrowser",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/simple-image-browser/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Simple Image Browser",
        "visible": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      },
      "csp": {
        "default-src": "'self' asset: http://asset.localhost",
        "media-src": "'self' asset: http://asset.localhost",
        "img-src": "'self' asset: http://asset.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "uninstallerHeaderImage": "icons/installer-header.bmp"
      }
    }
  }
}
